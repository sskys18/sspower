{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "strengths", "issues", "assessment"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "approve-with-followups", "needs-attention"],
      "description": "approve = no issues; approve-with-followups = only advisory issues, ship anyway; needs-attention = at least one blocking issue"
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What was done well"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "body", "file", "line_start", "line_end", "recommendation", "suggested_patch"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "advisory"],
            "description": "blocking = correctness, security, or data-loss; advisory = style, naming, doc-only nits, minor refactors"
          },
          "title": { "type": "string", "description": "Brief issue title" },
          "body": { "type": "string", "description": "Detailed explanation" },
          "file": { "type": "string", "description": "File path" },
          "line_start": { "type": "integer", "description": "Start line" },
          "line_end": { "type": "integer", "description": "End line" },
          "recommendation": { "type": "string", "description": "How to fix" },
          "suggested_patch": {
            "type": ["string", "null"],
            "description": "Unified diff against current HEAD for mechanical fixes (typos, missing imports, simple refactors). Set to null for design/architecture issues that need human judgment."
          }
        }
      }
    },
    "assessment": {
      "type": "string",
      "description": "Overall quality assessment"
    }
  }
}
