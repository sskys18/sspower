#!/usr/bin/env bash
# SessionStart hook for sspower plugin

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_log.sh" 2>/dev/null || true
trap '_sspower_exit_guard $? "0 20" hook.session-start' EXIT

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Capture the SessionStart payload (JSON on stdin) BEFORE any other read.
hook_payload="$(cat 2>/dev/null || true)"

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# --- sspower-mem call wrapper (spec §9 Phase E) ---
# Delegates to bin/sspower-mem — the single entrypoint shared with skills,
# which owns the uvx offline->online retry (a cold or pruned uv cache
# self-heals instead of silently killing memory for the session).
# ALWAYS returns 0 so the caller (running under set -e) is not killed.
# Communicates the normalized rc via SSP_RC and output via SSP_OUT.
sspower_mem_call() {
    # Usage: sspower_mem_call <subcommand> [args...]
    # Sets globals: SSP_OUT (CLI stdout), SSP_RC (normalized exit code).
    local wrapper="${PLUGIN_ROOT}/bin/sspower-mem"
    if [ ! -x "$wrapper" ]; then
      SSP_OUT=""
      SSP_RC=30
      echo "[sspower-mem] wrapper missing or not executable: $wrapper" >&2
      return 0
    fi

    set +e
    # Wrapper keeps stdout clean (CLI JSON only); its diagnostics + any uvx
    # build noise go to stderr, which we let flow to the hook's stderr.
    SSP_OUT=$("$wrapper" "$@")
    SSP_RC=$?
    set -e
    # Wrapper already normalizes to {0,10,20,30}; re-clamp defensively.
    case "$SSP_RC" in
      0)  : ;;  # success; $SSP_OUT is the result
      10) echo "[sspower-mem] degraded (rc=10, the index-backend step failed)" >&2 ;;
      20) echo "[sspower-mem] HARD fail (rc=20, digest unwritable)" >&2 ;;
      30) echo "[sspower-mem] dep missing (rc=30, uvx/cache unavailable)" >&2; SSP_OUT="" ;;
      *)  echo "[sspower-mem] unexpected rc=$SSP_RC" >&2; SSP_RC=30; SSP_OUT="" ;;
    esac
    return 0  # CRITICAL: never propagate via return value under set -e.
}

# --- Recent project memory from sspower-mem (best-effort, never blocks) ---
mem_block=""
payload_cwd="$(printf '%s' "$hook_payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
if [ -n "$payload_cwd" ]; then
    sspower_mem_call search --cwd "$payload_cwd" --scope project,user --mode recent --top-k 8 --json
    # NOTE: `search` never returns rc 20 (no data-loss surface at SessionStart),
    # so there is intentionally no `20) exit 20` branch here — that branch in the
    # spec's §9 example applies only to the `add` caller in wiki-archive.py.
    case "$SSP_RC" in
      0)
        # Format the JSON result array to a compact text block.
        mem_text="$(printf '%s' "$SSP_OUT" | jq -r '
            if (type=="array" and length>0) then
              (.[] | "- [\(.layer)] \(.content | gsub("\n";" "))")
            else empty end' 2>/dev/null || true)"
        if [ -n "$mem_text" ]; then
            mem_escaped="$(escape_for_json "$mem_text")"
            mem_block="\\n\\n---\\n**Recent project memory (sspower-mem):**\\n${mem_escaped}"
        fi
        ;;
      10|30) : ;;   # degraded / dep-missing -> fall back to no extra context
    esac
fi

session_context="<EXTREMELY_IMPORTANT>\nYou have sspower - a workflow engine. The prompt-submit hook routes skills by intent and auto-starts a plan->review->exec->test->review flow on multi-step work. Run \`/flow status\` to inspect an active flow, \`/flow abort\` to clear one. Invoke skills via the Skill tool; \`/using-sspower\` is the skill reference.\n</EXTREMELY_IMPORTANT>${mem_block}"

# Output context injection as JSON (Claude Code format).
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

# Detached graph session-refresh worker (P2). Fail-OPEN: any failure
# lands in the log file; never blocks the session start.
if command -v node >/dev/null 2>&1 && [[ -e "$PWD/.claude/graph/index.sqlite" ]]; then
  mkdir -p "$HOME/.claude/sspower" 2>/dev/null
  CLAUDE_PLUGIN_ROOT="$PLUGIN_ROOT" node "$PLUGIN_ROOT/bin/sspower-graph.mjs" \
    session-refresh --cwd "$PWD" --max-time 5 \
    >/dev/null 2>>"$HOME/.claude/sspower/graph-session.log" &
  disown
fi

# P3: write per-project session-state file. Reuses $hook_payload captured
# at the top of this hook script; stdin has already been drained.
if [ -n "${hook_payload:-}" ]; then
  SID="$(printf '%s' "$hook_payload" | jq -r '.session_id // empty' 2>/dev/null || true)"
  CWD="$(printf '%s' "$hook_payload" | jq -r '.cwd // empty' 2>/dev/null || true)"
  SRC="$(printf '%s' "$hook_payload" | jq -r '.source // "unknown"' 2>/dev/null || true)"
  if [ -n "$SID" ] && [ -n "$CWD" ]; then
    STATE_DIR="${SSPOWER_SESSION_STATE_DIR:-$HOME/.claude/state/sspower/sessions}"
    mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
    HASH="$(printf '%s' "$(realpath "$CWD" 2>/dev/null || echo "$CWD")" | shasum -a 256 | cut -c1-8)"
    TMP="$STATE_DIR/.$HASH.tmp.$$"
    cat > "$TMP" <<EOF
{"session_id":"$SID","cwd":"$CWD","started_ts":"$(date -u +%Y-%m-%dT%H:%M:%SZ)","hook_event_name":"SessionStart","source":"$SRC"}
EOF
    chmod 600 "$TMP"
    mv -f "$TMP" "$STATE_DIR/$HASH.json"
  fi
fi

exit 0
